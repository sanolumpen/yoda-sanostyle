// -*- mode: jsonc -*-
{
  "height": 40,
  "spacing": 4,
  "margin-top": 8,
  "margin-left": 16,
  "margin-right": 20,
  "modules-left": ["clock", "custom/gcal_next", "custom/brave", "custom/discord", "custom/steam", "custom/gdevelop", "custom/launchers"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["custom/settings", "pulseaudio", "network", "battery", "custom/language_toggle", "custom/language", "custom/power"],

  "hyprland/workspaces": {
    "format": "",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": [], "6": [], "7": [], "8": [], "9": []
    }
  },

  "clock": {
    "format": "{:%B %d  %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%I:%M %p}"
  },

  "battery": {
    "states": { "good": 80, "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-full": "{icon}",
    "format-charging": "󱐋",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{capacity}% - {timeTo}"
  },

  "network": {
    "format-wifi": "󰤢",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid}\n{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": "󰤭",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "backend": "pipewire",
    "format": "󰾭",
    "format-muted": "󰝟",
    "tooltip-format": "{volume}%",
    "tooltip": true,
    "on-click": "pavucontrol"
  },

  "custom/language": {
    "exec": "~/.config/waybar/scripts/fcitx5-status.sh",
    "interval": "once",
    "signal": 9,
    "format": "{}"
  },

  "custom/language_toggle": {
    "format": "󰗊",
    "tooltip-format": "Change Language / Cambiar Idioma",
    "on-click": "~/.config/eww/scripts/toggle_lang.sh"
  },

  "custom/settings": {
    "format": "󰒘",
    "tooltip-format": "Desktop Settings / Configuración",
    "on-click": "eww open --toggle settings_window"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/wlogout/wlogout.sh"
  },

  "custom/gcal_next": {
    "exec": "~/.config/eww/scripts/gcal_wrapper.sh next",
    "interval": 300,
    "format": "{}",
    "max-length": 30,
    "tooltip": false,
    "on-click": "eww open date_window"
  },

  "custom/launchers": {
    "format": "{}",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "custom/brave": {
    "format": "󰈟",
    "tooltip": "Brave Browser",
    "on-click": "~/.config/waybar/scripts/launch-app.sh brave"
  },

  "custom/discord": {
    "format": "󰙯",
    "tooltip": "Discord",
    "on-click": "~/.config/waybar/scripts/launch-app.sh discord"
  },

  "custom/steam": {
    "format": "󰓛",
    "tooltip": "Steam",
    "on-click": "~/.config/waybar/scripts/launch-app.sh steam"
  },

  "custom/gdevelop": {
    "format": "󰈙",
    "tooltip": "GDevelop 5",
    "on-click": "~/.config/waybar/scripts/launch-app.sh gdevelop5"
  }
}
