# Yoda Theme Configuration for htop
# Based on Kuri-Dots Yoda Rice

# Connection (don't change)
htop_version=3.2.2

# Color scheme (0 = unsorted, 1 = light, 2 = dark, 3 = midnight, 4 = bad, 5 = default, 6 = friendly)
color_theme=5

# Detailed settings
delay=15
description=Last updated: 2026-05-10
left_meters=MainMemory CPU System
left_meterModes=1 1 1
right_meters=Tasks LoadAverage Uptime
right_meterModes=2 2 2

# Tree view
tree_view=0

# Sort key (20 = COMMAND, 42 = TIME+, etc.)
sort_key=42

# Sort direction (1 = ascending, -1 = descending)
sort_direction=1

# Hide threads
hide_kernel_threads=1
hide_userland_threads=0

# Highlight program name
highlight_base_name=1
highlight_threads=1

# Find cursor
find_on_top=0

# Sort CPU by core
sort_cpu_per_core=0

# Show CPU frequency
show_cpu_frequency=0

# Show CPU temperature
show_cpu_temperature=1
cpu_temperature_units=0

# Enable tree expansion
tree_expand=1
tree_sort_key=0
tree_sort_direction=1
tree_view_always=0

# Hide function in proc view
hide_function_names=0

# Show screen name
show_program_name=0

# Use screen size
use_nav_scroll=1

# Highlight large pages
highlight_large_pages=1

# Enable mouse support
enable_mouse=1

# custom command (leave empty for default)
custom_command_line=

# Base architecture name
default_content_kind=1

# Fields configuration
fields=0 42 48 1 1 46 47 49 1

# Per-buffer fields
Per_cpu_buffer=1