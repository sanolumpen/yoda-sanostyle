{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "debian",
        "color": {
            "1": "32", // Verde fuerte para el espiral
            "2": "white" 
        },
        "padding": {
            "top": 1,
            "left": 1
        }
    },
    "display": {
        "separator": " 󰄾 ",
        "color": "magenta"
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "",
            "keyColor": "green"
        },
        {
            "type": "os",
            "key": "󰣚", // Debian Icon
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "magenta"
        },
        {
            "type": "host",
            "key": "󰌢",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮", // Icono Nvidia
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
